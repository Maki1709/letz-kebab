<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0b0b0b">
<meta name="description" content="Lët'z Kebab – Entdecke frischen Geschmack in Hobscheid, Luxemburg.">
<title>Lët'z Kebab | Taste the Difference</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
:root {
  --bg:#090909;
  --panel:#141414;
  --white:#f7f7f7;
  --muted:#a6a6a6;
  --red:#f04432;
  --red-dark:#a92118;
  --line:rgba(255,255,255,.12);
  --radius:22px;
  --max:1240px;
}
* {margin:0;padding:0;box-sizing:border-box}
html {scroll-behavior:smooth;scroll-padding-top:90px}
body {
  background:var(--bg);
  color:var(--white);
  font-family:Inter,Arial,sans-serif;
  overflow-x:hidden;
}
body.loading {overflow:hidden}
a {color:inherit;text-decoration:none}
button {font:inherit}
img,video {display:block;max-width:100%}
::selection {background:var(--red);color:white}
.container {width:min(var(--max),90%);margin:auto}
.eyebrow {
  display:inline-flex;align-items:center;gap:10px;
  color:var(--red);font-size:.75rem;font-weight:800;
  letter-spacing:3px;text-transform:uppercase;
}
.eyebrow:before {
  content:"";width:27px;height:2px;background:var(--red);
}
h1,h2,h3,.display {font-family:Anton,Impact,sans-serif;font-weight:400}
h2 {font-size:clamp(2.8rem,6vw,5.5rem);line-height:.98;letter-spacing:-1px}
.section {padding:115px 0}
.section-head {
  display:flex;justify-content:space-between;align-items:end;
  gap:30px;margin-bottom:48px;
}
.section-head p {max-width:380px;color:var(--muted);line-height:1.8}
.red {color:var(--red)}
.btn {
  display:inline-flex;align-items:center;justify-content:center;gap:12px;
  min-height:54px;padding:0 25px;border:1px solid var(--red);
  border-radius:5px;background:var(--red);color:white;
  text-transform:uppercase;font-size:.78rem;font-weight:800;
  letter-spacing:1.2px;cursor:pointer;
  transition:background .3s,transform .3s,border-color .3s;
}
.btn:hover {background:var(--red-dark);border-color:var(--red-dark);transform:translateY(-3px)}
.btn-outline {background:transparent;border-color:rgba(255,255,255,.35)}
.btn-outline:hover {background:white;color:#111;border-color:white}
.btn-arrow {font-size:1.2rem;transition:transform .3s}
.btn:hover .btn-arrow {transform:translateX(5px)}

/* LOADING SCREEN */
.loader {
  position:fixed;inset:0;z-index:9999;background:#080808;
  display:grid;place-items:center;transition:opacity .7s,visibility .7s;
}
.loader.done {opacity:0;visibility:hidden;pointer-events:none}
.loader-inner {text-align:center}
.loader-logo {font-family:Anton,sans-serif;font-size:clamp(2rem,7vw,4.5rem)}
.loader-logo span {color:var(--red)}
.loader-line {height:3px;width:180px;background:#292929;margin:20px auto;overflow:hidden}
.loader-line:after {
  content:"";display:block;width:45%;height:100%;background:var(--red);
  animation:loadline 1s ease-in-out infinite alternate;
}
@keyframes loadline {from{transform:translateX(-100%)}to{transform:translateX(220%)}}

/* NAVIGATION */
header {
  position:fixed;inset:0 0 auto;z-index:1000;
  border-bottom:1px solid transparent;
  transition:background .4s,border-color .4s,backdrop-filter .4s;
}
header.scrolled {background:rgba(8,8,8,.92);backdrop-filter:blur(18px);border-color:var(--line)}
.nav {
  min-height:84px;display:flex;align-items:center;justify-content:space-between;gap:25px;
}
.brand {display:flex;align-items:center;gap:12px;font-family:Anton,sans-serif;font-size:1.5rem;letter-spacing:.4px}
.brand-mark {
  width:43px;height:43px;background:var(--red);display:grid;place-items:center;
  font-size:1.4rem;transform:skew(-5deg);border-radius:4px;
}
.brand small {display:block;color:var(--muted);font:700 .57rem Inter,sans-serif;letter-spacing:2px}
.nav-links {display:flex;align-items:center;gap:32px}
.nav-links a:not(.btn) {
  color:#ddd;font-size:.78rem;font-weight:700;transition:color .25s;
}
.nav-links a:not(.btn):hover {color:var(--red)}
.menu-toggle {
  display:none;background:none;border:1px solid var(--line);color:white;
  width:46px;height:46px;border-radius:5px;font-size:1.4rem;cursor:pointer;
}

/* HERO */
.hero {
  position:relative;min-height:100svh;display:flex;align-items:center;
  isolation:isolate;overflow:hidden;background:#111;
}
.hero-video,.hero-overlay {position:absolute;inset:0;width:100%;height:100%}
.hero-video {object-fit:cover;z-index:-3}
.hero-overlay {
  z-index:-2;
  background:
    linear-gradient(90deg,rgba(0,0,0,.91) 0%,rgba(0,0,0,.69) 45%,rgba(0,0,0,.18) 100%),
    linear-gradient(0deg,var(--bg) 0%,transparent 32%);
}
.hero-grain {
  position:absolute;inset:0;z-index:-1;pointer-events:none;opacity:.1;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.35'/%3E%3C/svg%3E");
}
.hero-content {padding-top:120px;padding-bottom:100px;max-width:850px}
.hero-kicker {
  display:inline-flex;align-items:center;gap:10px;
  font-size:.76rem;font-weight:800;letter-spacing:2px;text-transform:uppercase;
  color:#eee;margin-bottom:25px;
}
.live-dot {width:8px;height:8px;border-radius:50%;background:var(--red);box-shadow:0 0 15px var(--red)}
.hero h1 {
  font-size:clamp(4.3rem,11vw,10rem);line-height:.83;
  letter-spacing:-2px;text-transform:uppercase;margin-bottom:30px;
}
.hero h1 .outline {-webkit-text-stroke:1.5px white;color:transparent}
.hero h1 .highlight {color:var(--red)}
.hero-copy {max-width:480px;color:#d1d1d1;line-height:1.9;font-size:1rem;margin-bottom:32px}
.hero-actions {display:flex;flex-wrap:wrap;gap:13px}
.hero-bottom {
  position:absolute;bottom:35px;left:5%;right:5%;
  display:flex;justify-content:space-between;align-items:center;gap:20px;
}
.hero-bottom span {color:#bbb;font-size:.7rem;letter-spacing:2px;text-transform:uppercase}
.scroll-cue {display:flex;align-items:center;gap:12px}
.scroll-cue i {height:1px;width:55px;background:var(--red)}
.hero-index {font-family:Anton,sans-serif;font-size:1.15rem}
.hero-index span {color:var(--red)}

/* MOVING STRIP */
.ticker {overflow:hidden;background:var(--red);transform:rotate(-1.2deg) scale(1.02);padding:17px 0}
.ticker-track {display:flex;width:max-content;animation:ticker 28s linear infinite}
.ticker-item {
  display:flex;align-items:center;gap:25px;padding:0 25px;
  font-family:Anton,sans-serif;font-size:1.25rem;letter-spacing:1px;text-transform:uppercase;
}
.ticker-item b {font-size:1rem;color:#111}
@keyframes ticker {to{transform:translateX(-50%)}}

/* STORY */
.story-grid {display:grid;grid-template-columns:1fr 1fr;gap:75px;align-items:center}
.story-visual {position:relative;min-height:550px}
.story-photo {
  position:absolute;inset:0 55px 40px 0;overflow:hidden;border-radius:var(--radius);
  background:#1b1b1b;
}
.story-photo img {width:100%;height:100%;object-fit:cover;transition:transform .8s}
.story-photo:hover img {transform:scale(1.06)}
.story-photo:after {
  content:"";position:absolute;inset:0;
  background:linear-gradient(0deg,rgba(0,0,0,.55),transparent 55%);
}
.story-stamp {
  position:absolute;right:0;bottom:0;width:175px;height:175px;
  background:var(--red);border:8px solid var(--bg);border-radius:50%;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  text-align:center;transform:rotate(8deg);
}
.story-stamp strong {font:2.4rem Anton,sans-serif}
.story-stamp span {font-size:.65rem;letter-spacing:1px;font-weight:800}
.story-copy h2 {margin:20px 0 25px}
.story-copy p {color:var(--muted);line-height:1.95;margin-bottom:20px}
.story-points {display:grid;grid-template-columns:1fr 1fr;gap:18px;margin:30px 0}
.story-point {border-top:1px solid var(--line);padding-top:17px}
.story-point strong {display:block;margin-bottom:8px;font-size:.9rem}
.story-point span {font-size:.78rem;line-height:1.7;color:var(--muted)}

/* MENU */
.menu-section {background:#101010;position:relative}
.menu-section:before {
  content:"MENU";position:absolute;top:40px;right:-20px;
  font:clamp(6rem,18vw,17rem) Anton,sans-serif;color:rgba(255,255,255,.018);
  pointer-events:none;
}
.menu-filters {display:flex;flex-wrap:wrap;gap:10px;margin-bottom:35px}
.filter-btn {
  background:transparent;border:1px solid var(--line);color:#ccc;
  padding:12px 20px;border-radius:4px;font-size:.76rem;font-weight:800;
  text-transform:uppercase;cursor:pointer;transition:.3s;
}
.filter-btn:hover,.filter-btn.active {background:var(--red);border-color:var(--red);color:white}
.menu-grid {display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.menu-card {
  background:#181818;border:1px solid rgba(255,255,255,.07);
  border-radius:12px;overflow:hidden;transition:transform .35s,border-color .35s,opacity .3s;
}
.menu-card:hover {transform:translateY(-8px);border-color:rgba(240,68,50,.65)}
.menu-card.hidden {display:none}
.menu-image {height:235px;position:relative;overflow:hidden;background:#252525}
.menu-image img {width:100%;height:100%;object-fit:cover;transition:transform .7s}
.menu-card:hover .menu-image img {transform:scale(1.08)}
.menu-tag {
  position:absolute;top:15px;left:15px;background:var(--red);
  padding:8px 11px;font-size:.62rem;font-weight:800;letter-spacing:1px;text-transform:uppercase;
}
.menu-card-content {padding:24px}
.menu-card h3 {font-size:1.7rem;letter-spacing:.2px;margin-bottom:10px}
.menu-card p {font-size:.83rem;color:var(--muted);line-height:1.8;min-height:48px}
.menu-card-bottom {
  display:flex;align-items:center;justify-content:space-between;
  gap:10px;margin-top:22px;padding-top:17px;border-top:1px solid var(--line);
}
.menu-card-bottom span {font-size:.7rem;font-weight:800;color:#eee;text-transform:uppercase;letter-spacing:.8px}
.menu-card-bottom b {color:var(--red);font-size:.75rem}
.menu-note {margin-top:28px;color:#858585;font-size:.76rem;line-height:1.8}

/* FEATURE BANNER */
.feature-banner {
  min-height:440px;position:relative;display:flex;align-items:center;overflow:hidden;
  background:#161616;
}
.feature-banner img {position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0}
.feature-banner:after {
  content:"";position:absolute;inset:0;
  background:linear-gradient(90deg,rgba(0,0,0,.92),rgba(0,0,0,.4));
}
.feature-content {position:relative;z-index:1;padding:80px 0;max-width:650px}
.feature-content h2 {margin:22px 0}
.feature-content p {color:#ddd;line-height:1.9;max-width:470px;margin-bottom:28px}

/* GALLERY */
.gallery-grid {display:grid;grid-template-columns:1.2fr .8fr .8fr;grid-template-rows:230px 230px;gap:15px}
.gallery-item {position:relative;overflow:hidden;border-radius:10px;background:#191919}
.gallery-item:first-child {grid-row:span 2}
.gallery-item img {width:100%;height:100%;object-fit:cover;transition:transform .8s,filter .5s;filter:brightness(.8)}
.gallery-item:hover img {transform:scale(1.08);filter:brightness(1)}
.gallery-item:after {content:"";position:absolute;inset:50% 0 0;background:linear-gradient(transparent,rgba(0,0,0,.7))}
.gallery-label {position:absolute;bottom:18px;left:18px;z-index:2;font:1.3rem Anton,sans-serif;text-transform:uppercase}

/* LOCATION */
.location-section {background:#111}
.location-grid {display:grid;grid-template-columns:.8fr 1.2fr;gap:35px;align-items:stretch}
.location-info {padding:40px;background:#181818;border:1px solid var(--line);border-radius:var(--radius)}
.location-info h2 {font-size:clamp(2.5rem,4vw,4rem);margin:20px 0}
.location-info>p {color:var(--muted);line-height:1.9;margin-bottom:30px}
.info-row {display:flex;gap:17px;padding:20px 0;border-top:1px solid var(--line)}
.info-icon {
  flex:0 0 42px;height:42px;display:grid;place-items:center;
  background:rgba(240,68,50,.13);color:var(--red);border-radius:7px;font-size:1.1rem;
}
.info-row strong {display:block;font-size:.83rem;margin:2px 0 7px}
.info-row span {font-size:.78rem;color:var(--muted);line-height:1.7}
.map-frame {min-height:480px;overflow:hidden;border-radius:var(--radius);border:1px solid var(--line)}
.map-frame iframe {width:100%;height:100%;min-height:480px;border:0;filter:grayscale(1) invert(.9) contrast(.85)}

/* FINAL CTA */
.final-cta {padding:100px 0;text-align:center;position:relative;overflow:hidden}
.final-cta:before {
  content:"LET'S EAT";position:absolute;left:50%;top:50%;
  transform:translate(-50%,-50%);font:clamp(5rem,16vw,15rem) Anton,sans-serif;
  color:rgba(255,255,255,.025);white-space:nowrap;pointer-events:none;
}
.final-cta .container {position:relative}
.final-cta h2 {margin:22px 0}
.final-cta p {color:var(--muted);line-height:1.9;max-width:520px;margin:0 auto 28px}

/* FOOTER */
footer {background:#050505;border-top:1px solid var(--line);padding:45px 0 25px}
.footer-top {display:flex;justify-content:space-between;gap:30px;align-items:center;padding-bottom:35px}
.footer-brand p {font-size:.77rem;color:var(--muted);margin-top:10px}
.footer-links {display:flex;flex-wrap:wrap;gap:22px}
.footer-links a {font-size:.76rem;color:#bbb;transition:color .3s}
.footer-links a:hover {color:var(--red)}
.footer-bottom {
  padding-top:23px;border-top:1px solid var(--line);
  display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap;
  color:#777;font-size:.7rem;
}
.back-top {
  position:fixed;right:22px;bottom:22px;z-index:500;
  width:46px;height:46px;background:var(--red);color:white;border:0;
  border-radius:5px;cursor:pointer;opacity:0;visibility:hidden;
  transform:translateY(12px);transition:.3s;
}
.back-top.visible {opacity:1;visibility:visible;transform:translateY(0)}
.back-top:hover {background:var(--red-dark)}

/* SCROLL ANIMATIONS */
.reveal {opacity:0;transform:translateY(35px);transition:opacity .8s ease,transform .8s ease}
.reveal.show {opacity:1;transform:translateY(0)}
.reveal-delay-1 {transition-delay:.12s}
.reveal-delay-2 {transition-delay:.24s}
.reveal-delay-3 {transition-delay:.36s}
.hero-content>* {animation:heroIn .8s both}
.hero-content>*:nth-child(1) {animation-delay:.15s}
.hero-content>*:nth-child(2) {animation-delay:.28s}
.hero-content>*:nth-child(3) {animation-delay:.42s}
.hero-content>*:nth-child(4) {animation-delay:.56s}
@keyframes heroIn {from{opacity:0;transform:translateY(25px)}to{opacity:1;transform:translateY(0)}}

/* RESPONSIVE */
@media(max-width:900px) {
  .nav-links {gap:18px}
  .nav-links a:not(.btn) {font-size:.7rem}
  .story-grid {gap:40px}
  .story-visual {min-height:450px}
  .menu-grid {grid-template-columns:repeat(2,1fr)}
  .location-grid {grid-template-columns:1fr}
  .map-frame,.map-frame iframe {min-height:400px}
}
@media(max-width:700px) {
  .section {padding:80px 0}
  .nav {min-height:72px}
  .menu-toggle {display:block}
  .nav-links {
    position:absolute;top:72px;left:0;right:0;background:rgba(8,8,8,.98);
    border-bottom:1px solid var(--line);padding:25px 5%;
    display:flex;flex-direction:column;align-items:stretch;gap:0;
    opacity:0;visibility:hidden;transform:translateY(-10px);
    transition:.3s;
  }
  .nav-links.open {opacity:1;visibility:visible;transform:translateY(0)}
  .nav-links a:not(.btn) {font-size:.85rem;padding:16px 0;border-bottom:1px solid var(--line)}
  .nav-links .btn {margin-top:18px}
  .hero {min-height:92svh}
  .hero-content {padding-top:135px}
  .hero h1 {font-size:clamp(4rem,17vw,7rem)}
  .hero-copy {font-size:.9rem}
  .hero-bottom {bottom:25px}
  .section-head {display:block}
  .section-head p {margin-top:20px}
  .story-grid {grid-template-columns:1fr;gap:45px}
  .story-visual {min-height:440px}
  .story-copy h2 {font-size:3.6rem}
  .menu-grid {grid-template-columns:1fr}
  .menu-image {height:260px}
  .gallery-grid {grid-template-columns:1fr 1fr;grid-template-rows:220px 180px 180px}
  .gallery-item:first-child {grid-row:auto;grid-column:span 2}
  .location-info {padding:27px}
  .map-frame,.map-frame iframe {min-height:330px}
  .footer-top {align-items:flex-start;flex-direction:column}
}
@media(max-width:420px) {
  .container {width:90%}
  .hero h1 {font-size:3.65rem}
  .hero-actions .btn {width:100%}
  .story-visual {min-height:350px}
  .story-stamp {width:135px;height:135px;border-width:5px}
  .story-stamp strong {font-size:1.9rem}
  .story-points {grid-template-columns:1fr}
  .gallery-grid {grid-template-rows:180px 145px 145px;gap:9px}
  .gallery-label {font-size:1rem;left:12px;bottom:12px}
  .filter-btn {padding:10px 13px;font-size:.68rem}
}
@media(prefers-reduced-motion:reduce) {
  *,*::before,*::after {
    scroll-behavior:auto!important;animation-duration:.01ms!important;
    animation-iteration-count:1!important;transition-duration:.01ms!important;
  }
  .reveal {opacity:1;transform:none}
}
</style>
</head>

