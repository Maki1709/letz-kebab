<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#101010">

<title>Lët’z Kebab | Fresh Street Food in Hobscheid</title>

<meta name="description" content="Discover Lët’z Kebab in Hobscheid, Luxembourg. Enjoy kebabs, tacos, pizza and more at 25 Grand-Rue.">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Oswald:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
/* =========================================
   LËT'Z KEBAB — PREMIUM RESTAURANT WEBSITE
   Single-file HTML, CSS and JavaScript
========================================= */

:root {
    --background: #101010;
    --surface: #181818;
    --surface-light: #222222;
    --red: #f04438;
    --red-dark: #bd2821;
    --white: #ffffff;
    --muted: #a5a5a5;
    --border: rgba(255,255,255,.1);
    --title-font: 'Oswald', sans-serif;
    --body-font: 'DM Sans', sans-serif;
    --transition: .35s cubic-bezier(.2,.8,.2,1);
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: 90px;
}

body {
    background: var(--background);
    color: var(--white);
    font-family: var(--body-font);
    overflow-x: hidden;
}

body.menu-open {
    overflow: hidden;
}

a {
    color: inherit;
    text-decoration: none;
}

button {
    font-family: inherit;
}

img {
    display: block;
    width: 100%;
}

button, a {
    -webkit-tap-highlight-color: transparent;
}

::selection {
    background: var(--red);
    color: white;
}

.container {
    width: min(1180px, 90%);
    margin-inline: auto;
}

.section {
    padding: 110px 0;
    position: relative;
}

.section-label {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--red);
    text-transform: uppercase;
    letter-spacing: 3px;
    font-size: 11px;
    font-weight: 800;
    margin-bottom: 22px;
}

.section-label::before {
    content: "";
    width: 28px;
    height: 2px;
    background: var(--red);
}

.section-title {
    font-family: var(--title-font);
    font-size: clamp(42px, 6vw, 76px);
    font-weight: 600;
    text-transform: uppercase;
    line-height: 1.03;
}

.section-title span {
    color: var(--red);
}

.section-text {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.9;
    max-width: 560px;
    margin-top: 22px;
}

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 16px 25px;
    background: var(--red);
    color: white;
    border: 1px solid var(--red);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.3px;
    text-transform: uppercase;
    transition: var(--transition);
    cursor: pointer;
}

.btn:hover {
    background: var(--red-dark);
    border-color: var(--red-dark);
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(240,68,56,.2);
}

.btn-outline {
    background: transparent;
    border-color: rgba(255,255,255,.3);
}

.btn-outline:hover {
    background: white;
    border-color: white;
    color: #111;
}

.btn-arrow {
    font-size: 18px;
    transition: transform var(--transition);
}

.btn:hover .btn-arrow {
    transform: translateX(4px);
}

.section-heading {
    margin-bottom: 55px;
}

.section-heading.center {
    text-align: center;
}

.section-heading.center .section-label {
    justify-content: center;
}

.section-heading.center .section-text {
    margin-inline: auto;
}

/* PAGE LOADER */

.loader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: #101010;
    display: grid;
    place-items: center;
    transition: opacity .7s ease, visibility .7s ease;
}

.loader.hidden {
    opacity: 0;
    visibility: hidden;
}

.loader-content {
    text-align: center;
}

.loader-logo {
    font-family: var(--title-font);
    font-size: 48px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
}

.loader-logo span {
    color: var(--red);
}

.loader-line {
    width: 180px;
    height: 3px;
    background: #292929;
    margin: 22px auto 0;
    overflow: hidden;
}

.loader-line::after {
    content: "";
    display: block;
    width: 50%;
    height: 100%;
    background: var(--red);
    animation: loading 1s ease-in-out infinite alternate;
}

@keyframes loading {
    from { transform: translateX(0); }
    to { transform: translateX(100%); }
}

/* NAVIGATION */

.navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    padding: 24px 0;
    border-bottom: 1px solid transparent;
    transition: padding var(--transition), background var(--transition), border-color var(--transition);
}

.navbar.scrolled {
    padding: 14px 0;
    background: rgba(12,12,12,.92);
    backdrop-filter: blur(18px);
    border-color: var(--border);
}

.nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
}

.logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
}

.logo-symbol {
    width: 45px;
    height: 45px;
    display: grid;
    place-items: center;
    background: var(--red);
    font-family: var(--title-font);
    font-size: 28px;
    font-weight: 700;
    transform: skew(-5deg);
}

.logo-name {
    font-family: var(--title-font);
    font-size: 23px;
    line-height: 1;
    font-weight: 600;
    text-transform: uppercase;
}

.logo-name span {
    color: var(--red);
}

.logo-caption {
    display: block;
    color: #aaa;
    font-size: 8px;
    letter-spacing: 3px;
    margin-top: 6px;
}

.nav-links {
    display: flex;
    align-items: center;
    gap: 30px;
}

.nav-links a {
    position: relative;
    color: #dedede;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.3px;
    text-transform: uppercase;
    transition: color .25s;
}

.nav-links a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -8px;
    width: 0;
    height: 2px;
    background: var(--red);
    transition: width .3s;
}

.nav-links a:hover {
    color: white;
}

.nav-links a:hover::after {
    width: 100%;
}

.nav-button {
    padding: 13px 17px;
    font-size: 10px;
}

.menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    border: 1px solid var(--border);
    background: transparent;
    color: white;
    cursor: pointer;
    font-size: 24px;
}

/* HERO */

.hero {
    min-height: 780px;
    min-height: 100svh;
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: #111;
}

.hero-background {
    position: absolute;
    inset: 0;
    background:
        linear-gradient(90deg, rgba(10,10,10,.96) 0%, rgba(10,10,10,.84) 48%, rgba(10,10,10,.32) 100%),
        linear-gradient(0deg, #101010 0%, transparent 28%),
        url("https://images.unsplash.com/photo-1529006557810-274b9b2fc783?auto=format&fit=crop&w=2000&q=85") center/cover no-repeat;
    transform: scale(1.08);
    animation: heroZoom 1.6s cubic-bezier(.2,.8,.2,1) forwards;
}

@keyframes heroZoom {
    to { transform: scale(1); }
}

.hero-glow {
    position: absolute;
    width: 500px;
    height: 500px;
    right: 5%;
    top: 15%;
    background: rgba(240,68,56,.11);
    filter: blur(120px);
    pointer-events: none;
}

.hero-content {
    position: relative;
    z-index: 2;
    padding-top: 100px;
    max-width: 850px;
}

.hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 10px 15px;
    border: 1px solid rgba(255,255,255,.19);
    background: rgba(255,255,255,.04);
    color: #eee;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    animation: slideUp .8s .1s both;
}

.hero-tag i {
    display: block;
    width: 7px;
    height: 7px;
    background: var(--red);
    border-radius: 50%;
    box-shadow: 0 0 15px var(--red);
}

.hero h1 {
    margin-top: 30px;
    font-family: var(--title-font);
    font-size: clamp(65px, 10vw, 128px);
    font-weight: 700;
    text-transform: uppercase;
    line-height: .92;
    letter-spacing: -2px;
    animation: slideUp .8s .2s both;
}

.hero h1 .outline {
    color: transparent;
    -webkit-text-stroke: 1.5px white;
}

.hero h1 .red {
    color: var(--red);
}

.hero-description {
    max-width: 470px;
    color: #ccc;
    font-size: 14px;
    line-height: 1.9;
    margin-top: 28px;
    animation: slideUp .8s .3s both;
}

.hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 35px;
    animation: slideUp .8s .4s both;
}

.hero-bottom {
    position: absolute;
    z-index: 2;
    bottom: 42px;
    left: 5%;
    right: 5%;
    display: flex;
    justify-content: space-between;
    align-items: end;
}

.hero-location {
    display: flex;
    gap: 13px;
    align-items: center;
    color: #ddd;
    font-size: 11px;
    line-height: 1.7;
}

.hero-location strong {
    color: white;
    display: block;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.hero-location-icon {
    font-size: 24px;
    color: var(--red);
}

.scroll-indicator {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #bbb;
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
}

.scroll-indicator span {
    display: block;
    width: 40px;
    height: 1px;
    background: var(--red);
}

@keyframes slideUp {
    from { opacity: 0; transform: translateY(35px); }
    to { opacity: 1; transform: translateY(0); }
}

/* RUNNING STRIP */

.marquee {
    position: relative;
    z-index: 2;
    overflow: hidden;
    background: var(--red);
    padding: 20px 0;
    transform: rotate(-1deg) scale(1.02);
}

.marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 28s linear infinite;
}

.marquee-item {
    display: flex;
    align-items: center;
    gap: 25px;
    padding: 0 25px;
    white-space: nowrap;
    font-family: var(--title-font);
    font-size: 24px;
    font-weight: 600;
    text-transform: uppercase;
}

.marquee-item span {
    color: rgba(255,255,255,.6);
}

@keyframes marquee {
    to { transform: translateX(-50%); }
}

/* INTRODUCTION */

.intro-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 90px;
    align-items: center;
}

.intro-visual {
    position: relative;
    min-height: 510px;
}

.intro-image {
    position: absolute;
    inset: 0 45px 35px 0;
    overflow: hidden;
    background: var(--surface);
}

.intro-image img {
    height: 100%;
    object-fit: cover;
    transition: transform .8s;
}

.intro-image:hover img {
    transform: scale(1.06);
}

.intro-badge {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 190px;
    padding: 25px;
    background: var(--red);
}

.intro-badge strong {
    display: block;
    font-family: var(--title-font);
    font-size: 37px;
    line-height: 1;
    text-transform: uppercase;
}

.intro-badge span {
    display: block;
    font-size: 10px;
    line-height: 1.7;
    margin-top: 10px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.intro-copy .section-title {
    font-size: clamp(42px, 5vw, 63px);
}

.intro-copy .section-text {
    margin-bottom: 30px;
}

.intro-features {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin: 35px 0;
}

.feature {
    display: flex;
    align-items: flex-start;
    gap: 13px;
}

.feature-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    color: var(--red);
    background: rgba(240,68,56,.1);
    font-size: 19px;
}

.feature h3 {
    font-size: 12px;
    text-transform: uppercase;
    margin-bottom: 7px;
}

.feature p {
    color: var(--muted);
    font-size: 11px;
    line-height: 1.7;
}

/* MENU */

.menu-section {
    background: #151515;
    overflow: hidden;
}

.menu-section::before {
    content: "MENU";
    position: absolute;
    right: -30px;
    top: 70px;
    font-family: var(--title-font);
    font-size: 220px;
    color: rgba(255,255,255,.018);
    font-weight: 700;
    pointer-events: none;
}

.menu-header {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 35px;
}

.menu-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-bottom: 40px;
}

.filter-btn {
    padding: 11px 17px;
    border: 1px solid var(--border);
    background: transparent;
    color: #bbb;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: 9px;
    font-weight: 800;
    transition: var(--transition);
}

.filter-btn:hover,
.filter-btn.active {
    background: var(--red);
    border-color: var(--red);
    color: white;
}

.menu-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
}

.menu-card {
    position: relative;
    overflow: hidden;
    background: var(--surface-light);
    border: 1px solid rgba(255,255,255,.05);
    transition: transform .45s, border-color .45s, opacity .3s;
}

.menu-card:hover {
    transform: translateY(-8px);
    border-color: rgba(240,68,56,.55);
}

.menu-card.hidden {
    display: none;
}

.menu-image {
    position: relative;
    height: 230px;
    overflow: hidden;
    background: #292929;
}

.menu-image img {
    height: 100%;
    object-fit: cover;
    transition: transform .7s cubic-bezier(.2,.8,.2,1);
}

.menu-card:hover .menu-image img {
    transform: scale(1.09);
}

.menu-tag {
    position: absolute;
    top: 16px;
    left: 16px;
    padding: 8px 11px;
    background: var(--red);
    color: white;
    font-size: 9px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.menu-card-content {
    padding: 24px;
}

.menu-card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 15px;
}

.menu-card h3 {
    font-family: var(--title-font);
    font-size: 24px;
    text-transform: uppercase;
}

.menu-card p {
    color: var(--muted);
    font-size: 12px;
    line-height: 1.8;
    margin-top: 12px;
}

.menu-card-icon {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    background: rgba(240,68,56,.12);
    color: var(--red);
    font-size: 19px;
    transition: var(--transition);
}

.menu-card:hover .menu-card-icon {
    background: var(--red);
    color: white;
    transform: rotate(-8deg);
}

.menu-note {
    margin-top: 30px;
    padding: 18px 22px;
    border: 1px solid var(--border);
    color: var(--muted);
    font-size: 11px;
    line-height: 1.8;
}

/* FEATURE BANNER */

.feature-banner {
    position: relative;
    min-height: 430px;
    display: flex;
    align-items: center;
    overflow: hidden;
    background:
        linear-gradient(90deg, rgba(12,12,12,.96), rgba(12,12,12,.45)),
        url("https://images.unsplash.com/photo-1555939594-58d7cb561ad1?auto=format&fit=crop&w=1800&q=85") center/cover no-repeat;
}

.feature-banner-content {
    position: relative;
    z-index: 1;
    max-width: 670px;
}

.feature-banner h2 {
    font-family: var(--title-font);
    font-size: clamp(43px, 7vw, 82px);
    line-height: 1;
    text-transform: uppercase;
}

.feature-banner h2 span {
    color: var(--red);
}

.feature-banner p {
    max-width: 470px;
    margin: 24px 0 30px;
    color: #ccc;
    font-size: 13px;
    line-height: 1.9;
}

/* GALLERY */

.gallery-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    grid-template-rows: 250px 250px;
    gap: 16px;
}

.gallery-item {
    position: relative;
    overflow: hidden;
    background: var(--surface);
}

.gallery-item:first-child {
    grid-row: span 2;
}

.gallery-item img {
    height: 100%;
    object-fit: cover;
    transition: transform .8s cubic-bezier(.2,.8,.2,1), filter .5s;
}

.gallery-item:hover img {
    transform: scale(1.08);
    filter: brightness(.65);
}

.gallery-caption {
    position: absolute;
    left: 22px;
    bottom: 22px;
    z-index: 2;
    font-family: var(--title-font);
    font-size: 23px;
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(12px);
    transition: var(--transition);
}

.gallery-item:hover .gallery-caption {
    opacity: 1;
    transform: translateY(0);
}

/* EXPERIENCE */

.experience {
    padding: 65px 0;
    background: var(--red);
}

.experience-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 35px;
}

.experience-item {
    padding: 10px 20px;
    border-left: 1px solid rgba(255,255,255,.35);
}

.experience-item strong {
    display: block;
    font-family: var(--title-font);
    font-size: 26px;
    text-transform: uppercase;
}

.experience-item p {
    color: rgba(255,255,255,.8);
    font-size: 11px;
    line-height: 1.8;
    margin-top: 10px;
}

/* LOCATION */

.location-section {
    background: #151515;
}

.location-grid {
    display: grid;
    grid-template-columns: .85fr 1.15fr;
    gap: 65px;
    align-items: stretch;
}

.location-details {
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.location-details .section-text {
    margin-bottom: 30px;
}

.contact-row {
    display: flex;
    gap: 17px;
    align-items: flex-start;
    padding: 21px 0;
    border-bottom: 1px solid var(--border);
}

.contact-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 43px;
    height: 43px;
    background: rgba(240,68,56,.1);
    color: var(--red);
    font-size: 20px;
}

.contact-row h3 {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 8px;
}

.contact-row p,
.contact-row a {
    color: var(--muted);
    font-size: 12px;
    line-height: 1.8;
}

.contact-row a:hover {
    color: var(--red);
}

.location-map {
    min-height: 470px;
    background: #202020;
    border: 1px solid var(--border);
    position: relative;
    overflow: hidden;
}

.location-map iframe {
    width: 100%;
    height: 100%;
    min-height: 470px;
    border: 0;
    filter: grayscale(1) invert(.9) contrast(.9);
    transition: filter .4s;
}

.location-map:hover iframe {
    filter: grayscale(.3) invert(.9) contrast(.9);
}

.map-label {
    position: absolute;
    left: 20px;
    bottom: 20px;
    z-index: 2;
    padding: 14px 18px;
    background: var(--red);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
}

/* FINAL CTA */

.final-cta {
    position: relative;
    padding: 110px 0;
    text-align: center;
    overflow: hidden;
}

.final-cta::before {
    content: "";
    position: absolute;
    width: 500px;
    height: 500px;
    left: 50%;
    top: 50%;
    transform: translate(-50%,-50%);
    background: rgba(240,68,56,.08);
    filter: blur(110px);
    pointer-events: none;
}

.final-cta-content {
    position: relative;
    z-index: 1;
}

.final-cta h2 {
    font-family: var(--title-font);
    font-size: clamp(45px, 7vw, 86px);
    text-transform: uppercase;
    line-height: 1;
}

.final-cta h2 span {
    color: var(--red);
}

.final-cta p {
    max-width: 510px;
    margin: 23px auto 30px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.9;
}

.final-cta-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
}

/* FOOTER */

.footer {
    padding: 70px 0 25px;
    background: #0b0b0b;
    border-top: 1px solid var(--border);
}

.footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 55px;
    padding-bottom: 55px;
}

.footer-description {
    max-width: 340px;
    margin-top: 22px;
    color: var(--muted);
    font-size: 12px;
