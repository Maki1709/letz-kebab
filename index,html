/* BACK TO TOP */

.back-top {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 900;
    width: 46px;
    height: 46px;
    border: 1px solid rgba(255,255,255,.2);
    background: var(--red);
    color: white;
    font-size: 19px;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(15px);
    transition: var(--transition);
}

.back-top.visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}

.back-top:hover {
    background: white;
    color: #111;
}

/* SCROLL PROGRESS */

.progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    width: 0;
    height: 3px;
    background: var(--red);
    z-index: 2000;
}

